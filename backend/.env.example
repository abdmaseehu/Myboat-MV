# Server
NODE_ENV=production
PORT=8000

# Supabase Postgres (get from Supabase dashboard > Connect > Direct/Pooler)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Auth
JWT_SECRET=change_me_to_a_long_random_string_in_production

# File uploads
UPLOAD_PATH=./public/uploads

# Object storage (Supabase Storage)
#
# Uploads go to buckets when these are set, and to ./public/uploads when they
# are not. The container's disk does not survive a redeploy, so anything that
# has to outlive one — transfer slips above all — needs these in production.
#
# SUPABASE_URL is the project URL from Dashboard > Settings > API.
# SUPABASE_SERVICE_ROLE_KEY is the service_role secret on the same page. It
# bypasses row-level security, so it belongs on the server only — never in the
# frontend or in NEXT_PUBLIC_* anything.
#
# Buckets are created on first upload; the names below are only overrides.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PUBLIC=uploads
SUPABASE_BUCKET_PRIVATE=private-uploads
