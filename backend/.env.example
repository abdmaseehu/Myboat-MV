# Server
NODE_ENV=production
PORT=8000

# Supabase Postgres (get from Supabase dashboard > Connect > Direct/Pooler)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Auth
JWT_SECRET=change_me_to_a_long_random_string_in_production

# File uploads
UPLOAD_PATH=./public/uploads
