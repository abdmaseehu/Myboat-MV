# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
# Every .env variant, however it is suffixed. A backup named
# .env.bak-something is still a file full of secrets.
.env
.env.*
.env.local
.env.*.local

# Build
dist/
build/

# Logs
logs/
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Prisma
prisma/*.db

# Content snapshots taken before a bulk rewrite — local safety net, not history
prisma/seeds/_v17_backup.json

