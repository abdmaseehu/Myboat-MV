# API URL (backend deployed to Railway/Render)
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api/v1
NEXT_PUBLIC_ROOT_URL=https://your-backend.up.railway.app

# App branding
NEXT_PUBLIC_APP_NAME=Myboat MV
NEXT_PUBLIC_APP_DESCRIPTION="Myboat MV - Maldives Ferry & Speedboat Booking"

# JWT secret (must match backend)
NEXT_PUBLIC_JWT_SECRET=change_me_to_match_backend

NEXT_PUBLIC_NODE_ENV=production
